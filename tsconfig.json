{
  "include": ["**/*.ts", "**/*.mts"],
  "exclude": [
    "**/*.d.ts",
    "src/**/*.*" // Avoid Enonic XP source files
  ],

  "compilerOptions": {
    "strict": true,
    "lib": [
      "es2023" // string.replaceAll
    ],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "preserve",
    "moduleResolution": "bundler"
  }
}
